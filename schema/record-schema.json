{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/pfas-regulatory-tracker/record-schema.json",
  "title": "PFAS Environmental Law and Regulatory Tracker record contract",
  "type": "object",
  "required": ["id", "title", "record_type", "layer_id", "jurisdiction_id", "status", "review_state", "last_verified"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 3},
    "record_type": {"type": "string"},
    "layer_id": {"type": "string", "enum": ["us-federal", "oebgd", "fgs", "sofa-agreement", "host-nation", "installation-obligation"]},
    "jurisdiction_id": {"type": "string"},
    "status": {"type": "string"},
    "publication_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "effective_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "compliance_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "date_precision": {"type": "string", "enum": ["day", "month", "year", "unknown"]},
    "summary": {"type": "string", "minLength": 20},
    "determination": {"type": "string", "minLength": 20},
    "source_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "parent_ids": {"type": "array", "items": {"type": "string"}},
    "review_state": {"type": "string", "enum": ["verified", "needs_revalidation", "discovery_only", "superseded", "open", "blocked_pending_fgs_validation"]},
    "last_verified": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
